@model ProfileViewModel
@{
    ViewData["Title"] = "Your profile";
}
<section class="page-hero compact"><p class="eyebrow">YOUR RACEDAY ACCOUNT · @Model.Role</p><h1>Make it <em>you.</em></h1></section>
<section class="section profile-layout">
    <form asp-action="Profile" method="post" class="stack-form panel">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation"></div>
        <input asp-for="UserId" type="hidden" /><input asp-for="Role" type="hidden" />
        <div class="form-two"><div><label asp-for="FirstName"></label><input asp-for="FirstName" /></div><div><label asp-for="LastName"></label><input asp-for="LastName" /></div></div>
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" />
        <label asp-for="Phone"></label><input asp-for="Phone" autocomplete="tel" />
        @if (Model.DateOfBirth is not null) { <p class="muted">Date of birth · @Model.DateOfBirth.Value.ToString("dd MMM yyyy")</p> }
        <button class="button button-orange" type="submit">Save profile</button>
    </form>
    <aside class="panel profile-links">
        <p class="eyebrow">YOUR PROFILE PICTURE</p>
        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl)) { <img class="profile-picture" src="@Model.ProfilePictureUrl" alt="Profile picture" /> }
        <form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" class="stack-form">
            @Html.AntiForgeryToken()
            <label for="profile-file">Upload an image</label><input id="profile-file" name="File" type="file" accept="image/*" required data-preview-image />
            <img id="image-preview" class="image-preview" alt="Selected profile picture preview" hidden />
            <button class="button button-orange" type="submit">Upload picture</button>
        </form>
        <p class="eyebrow account-security-label">ACCOUNT SECURITY</p><h2>Keep it secure.</h2><p>Update your password any time.</p><a class="text-link" asp-action="Password">Change password ↗</a>
    </aside>
</section>

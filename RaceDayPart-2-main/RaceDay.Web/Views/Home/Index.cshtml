@model IReadOnlyList<EventViewModel>
@{
    ViewData["Title"] = "Find your next race";
}
<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">YOUR NEXT START LINE IS WAITING</p>
        <h1>Make every<br /><em>mile matter.</em></h1>
        <p class="lead">Find your next challenge, meet your people, and make race day yours.</p>
        <a class="button button-lime" href="#events">Explore events <span aria-hidden="true">↘</span></a>
    </div>
    <div class="hero-art" role="img" aria-label="Illustrated race-day course"><div class="sun"></div><div class="track track-one"></div><div class="track track-two"></div><div class="runner">RUN<br />YOUR<br />DAY</div></div>
</section>
<section class="section" id="events">
    <div class="section-heading">
        <div><p class="eyebrow">THE STARTING LINE</p><h2>Upcoming events</h2></div>
        <span class="count">@Model.Count.ToString("00") EVENTS</span>
    </div>
    <form asp-action="Index" method="get" class="event-filter panel">
        <label for="event-search">Search</label><input id="event-search" name="search" value="@ViewBag.Search" placeholder="Event or description" />
        <label for="event-type">Type</label><select id="event-type" name="type"><option value="">All types</option><option selected="@(ViewBag.Type as string == "Run")">Run</option><option selected="@(ViewBag.Type as string == "Walk")">Walk</option><option selected="@(ViewBag.Type as string == "Cycle")">Cycle</option></select>
        <label for="event-location">Location</label><input id="event-location" name="location" value="@ViewBag.Location" placeholder="City or venue" />
        <label for="event-from">From</label><input id="event-from" name="from" type="date" value="@ViewBag.From" />
        <label for="event-to">To</label><input id="event-to" name="to" type="date" value="@ViewBag.To" />
        <label for="upcoming-only">Date scope</label><select id="upcoming-only" name="upcomingOnly"><option value="true" selected="@(ViewBag.UpcomingOnly is true)">Upcoming only</option><option value="false" selected="@(ViewBag.UpcomingOnly is false)">All dates</option></select>
        <button class="button button-small button-orange" type="submit">Filter events</button>
    </form>
    @if (ViewBag.ApiError is string apiError)
    {
        <div class="empty-state"><span class="empty-icon">!</span><h3>Events are taking a breather</h3><p>@apiError</p><a class="text-link" asp-action="Index">Try again ↗</a></div>
    }
    else if (Model.Count == 0)
    {
        <div class="empty-state"><span class="empty-icon">↗</span><h3>New events are on the way</h3><p>Check back soon for your next challenge.</p></div>
    }
    else
    {
        <div class="event-grid">
        @foreach (var item in Model.OrderBy(e => e.Date))
        {
            <partial name="_EventCard" model="item" />
        }
        </div>
    }
</section>

@model IReadOnlyList<ResultViewModel>
@{
    ViewData["Title"] = "Manage results";
    var registrations = ViewBag.Registrations as List<RegistrationViewModel> ?? [];
}
<section class="page-hero compact"><p class="eyebrow">ORGANISER HUB</p><h1>Celebrate<br /><em>the finish.</em></h1><a class="text-link light-link" asp-action="Index">← Back to events</a></section>
<section class="section">
    <div class="section-heading"><div><p class="eyebrow">THE OFFICIAL RECORD</p><h2>Race results</h2></div><span class="count">@Model.Count.ToString("00") RESULTS</span></div>
    @if (ViewBag.ApiError is string error) { <p class="inline-error">@error</p> }
    @if (registrations.Count > 0)
    {
        <form asp-action="SaveResult" method="post" class="panel stack-form result-create-form">
            @Html.AntiForgeryToken()
            <h3>Record a result</h3>
            <label for="result-registration">Participant registration</label><select id="result-registration" name="RegistrationId" required><option value="">Select a registration</option>@foreach (var registration in registrations) { <option value="@registration.RegistrationId">@registration.ParticipantName · @registration.EventName</option> }</select>
            <div class="form-two"><div><label for="finish-time">Finish time</label><input id="finish-time" name="FinishTime" type="text" placeholder="hh:mm:ss" required /></div><div><label for="position">Position</label><input id="position" name="Position" type="number" min="1" value="1" required /></div></div>
            <label for="result-status">Result status</label><select id="result-status" name="Status"><option>Finished</option><option>DNF</option><option>DQ</option></select>
            <button class="button button-orange" type="submit">Save result</button>
        </form>
    }
    @if (Model.Count == 0) { <div class="empty-state"><h3>No results to show yet.</h3><p>Record a result from the event enrolments when the race is done.</p><a class="text-link" asp-action="Enrolments">View enrolments ↗</a></div> }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>Participant</th><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var result in Model)
        {
            <tr><td>@result.ParticipantName</td><td>@result.EventName</td><td>@result.EventDate?.ToString("dd MMM yyyy")</td><td>@result.Category</td><td>@result.FinishTime</td><td>@result.Position</td><td>@result.Status</td><td class="action-row">
                <a class="text-link" asp-action="EditResult" asp-route-id="@result.ResultId">Edit</a>
                <form asp-action="DeleteResult" method="post" data-confirm="Delete this result?">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@result.ResultId" /><button class="text-button danger" type="submit">Delete</button></form>
            </td></tr>
        }
        </tbody></table></div>
    }
</section>

@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="form-page">
    <p class="eyebrow">WELCOME BACK</p><h1>Ready when<br /><em>you are.</em></h1>
    <form asp-action="Login" method="post" class="stack-form" data-no-double-submit>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Email"></label><input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="field-error"></span>
        <button class="button button-orange" type="submit">Sign in <span aria-hidden="true">↗</span></button>
    </form>
    <p class="form-foot">New to RaceDay? <a asp-action="Register">Create an account</a></p>
</section>

@model PasswordFormViewModel
@{
    ViewData["Title"] = "Change password";
}
<section class="form-page">
    <p class="eyebrow">ACCOUNT SECURITY</p><h1>New password,<br /><em>new personal best.</em></h1>
    <form asp-action="Password" method="post" class="stack-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="validation"></div>
        <label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" />
        <label asp-for="NewPassword">New password</label><input asp-for="NewPassword" autocomplete="new-password" />
        <button class="button button-orange" type="submit">Update password</button>
    </form>
</section>

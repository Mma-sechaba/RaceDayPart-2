{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RaceDay API (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net10.0/RaceDay.Api.dll",
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5184"
      },
      "preLaunchTask": "build-raceday-api",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "RaceDay Web",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/RaceDay.Web/bin/Debug/net10.0/RaceDay.Web.dll",
      "cwd": "${workspaceFolder}/RaceDay.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "RaceDayApi__BaseUrl": "http://localhost:5184/"
      },
      "preLaunchTask": "build-raceday-web",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
